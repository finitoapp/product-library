{
  "name": "product-library",
  "private": true,
  "version": "26.11.1",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run check:lint && bun run check:ts && bun run check:tests && bun run build",
    "check:lint": "biome check .",
    "check:ts": "tsc --noEmit",
    "check:tests": "bun test",
    "format": "biome check --write .",
    "images:generate": "bun run scripts/generate-images.ts",
    "images:review": "bun run scripts/review.ts",
    "preview": "bun run build && bunx serve dist"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
